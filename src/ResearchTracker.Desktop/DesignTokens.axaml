<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="FwDanger">#EE999F</SolidColorBrush><SolidColorBrush x:Key="FwSuccess">#8CCDA5</SolidColorBrush><SolidColorBrush x:Key="FwPast">#25262B</SolidColorBrush><SolidColorBrush x:Key="FwPastText">#676B76</SolidColorBrush><SolidColorBrush x:Key="FwCommandBar">#18191C</SolidColorBrush>
   <SolidColorBrush x:Key="FwCanvas">#17181C</SolidColorBrush><SolidColorBrush x:Key="FwSurface">#202126</SolidColorBrush><SolidColorBrush x:Key="FwPanel">#1C1D21</SolidColorBrush><SolidColorBrush x:Key="FwInput">#191A1E</SolidColorBrush><SolidColorBrush x:Key="FwHover">#2C2933</SolidColorBrush><SolidColorBrush x:Key="FwBorder">#3A3543</SolidColorBrush><SolidColorBrush x:Key="FwTextPrimary">#E0E1E6</SolidColorBrush><SolidColorBrush x:Key="FwTextSecondary">#AFB1BB</SolidColorBrush><SolidColorBrush x:Key="FwTextMuted">#858894</SolidColorBrush><SolidColorBrush x:Key="FwAccent">#C4AFE9</SolidColorBrush><SolidColorBrush x:Key="FwWarning">#C6A579</SolidColorBrush><SolidColorBrush x:Key="FwGraphEdge">#666C7E</SolidColorBrush>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="FwDanger">#A52B38</SolidColorBrush><SolidColorBrush x:Key="FwSuccess">#216B3E</SolidColorBrush><SolidColorBrush x:Key="FwPast">#ECEDEF</SolidColorBrush><SolidColorBrush x:Key="FwPastText">#A6A9B1</SolidColorBrush><SolidColorBrush x:Key="FwCommandBar">#ECEDEF</SolidColorBrush>
   <SolidColorBrush x:Key="FwCanvas">#F4F4F6</SolidColorBrush><SolidColorBrush x:Key="FwSurface">#FFFFFF</SolidColorBrush><SolidColorBrush x:Key="FwPanel">#ECEDEF</SolidColorBrush><SolidColorBrush x:Key="FwInput">#FAFAFB</SolidColorBrush><SolidColorBrush x:Key="FwHover">#E9E3F1</SolidColorBrush><SolidColorBrush x:Key="FwBorder">#D2CADA</SolidColorBrush><SolidColorBrush x:Key="FwTextPrimary">#282A32</SolidColorBrush><SolidColorBrush x:Key="FwTextSecondary">#535764</SolidColorBrush><SolidColorBrush x:Key="FwTextMuted">#737784</SolidColorBrush><SolidColorBrush x:Key="FwAccent">#7853A5</SolidColorBrush><SolidColorBrush x:Key="FwWarning">#8D642E</SolidColorBrush><SolidColorBrush x:Key="FwGraphEdge">#8A90A0</SolidColorBrush>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <x:Double x:Key="FwFontCaption">11</x:Double><x:Double x:Key="FwFontBody">12</x:Double><x:Double x:Key="FwFontSection">14</x:Double><x:Double x:Key="FwFontTitle">16</x:Double>
 <CornerRadius x:Key="FwRadius">3</CornerRadius><Thickness x:Key="FwControlPadding">8,4</Thickness>
</ResourceDictionary>