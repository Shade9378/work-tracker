<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:nodify="clr-namespace:Nodify.Avalonia;assembly=Nodify.Avalonia">
 <Styles.Resources>
  <ControlTheme x:Key="FwNavigationItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="30"/><Setter Property="Foreground" Value="{DynamicResource FwTextPrimary}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource FwRadius}"><ContentPresenter Background="Transparent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></Border></ControlTemplate></Setter>
   <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource FwAccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource FwAccent}"/><Setter Property="BorderThickness" Value="2,0,0,0"/></Style>
   <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource FwHover}"/></Style>
  </ControlTheme>
 </Styles.Resources>
 <Style Selector="nodify|ItemContainer"><Setter Property="Template"><ControlTemplate><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></ControlTemplate></Setter></Style>
 <Style Selector="Window"><Setter Property="FontFamily" Value="Inter, Segoe UI"/><Setter Property="FontSize" Value="{StaticResource FwFontBody}"/><Setter Property="Background" Value="{DynamicResource FwCanvas}"/><Setter Property="Foreground" Value="{DynamicResource FwTextPrimary}"/></Style>
 <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource FwTextPrimary}"/></Style>
 <Style Selector="Button"><Setter Property="Transitions" Value="{x:Null}"/><Setter Property="MinHeight" Value="28"/><Setter Property="CornerRadius" Value="{StaticResource FwRadius}"/><Setter Property="Padding" Value="{StaticResource FwControlPadding}"/><Setter Property="FontSize" Value="{StaticResource FwFontBody}"/><Setter Property="Background" Value="{DynamicResource FwSurface}"/><Setter Property="Foreground" Value="{DynamicResource FwTextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource FwBorder}"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource FwHover}"/></Style>
 <Style Selector="Button.accent"><Setter Property="BorderBrush" Value="{DynamicResource FwAccent}"/><Setter Property="Background" Value="{DynamicResource FwAccent}"/><Setter Property="Foreground" Value="{DynamicResource FwOnAccent}"/></Style>
 <Style Selector="Button.accent:pointerover"><Setter Property="Background" Value="{DynamicResource FwAccent}"/></Style>
 <Style Selector="Button.accent:pressed"><Setter Property="Background" Value="{DynamicResource FwAccent}"/></Style>
 <Style Selector="Button.toolbar"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="8,3"/><Setter Property="CornerRadius" Value="2"/><Setter Property="FontWeight" Value="Normal"/></Style>
 <Style Selector="Button.toolbar:pointerover"><Setter Property="Background" Value="{DynamicResource FwHover}"/></Style>
 <Style Selector="Button.toolbar:pressed"><Setter Property="Background" Value="{DynamicResource FwHover}"/></Style>
 <Style Selector="Button.toolbar.active"><Setter Property="Foreground" Value="{DynamicResource FwAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource FwAccent}"/><Setter Property="BorderThickness" Value="0,0,0,2"/></Style>
 <Style Selector="Button.toolbar:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource FwAccent}"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style Selector="TextBox"><Setter Property="MinHeight" Value="28"/><Setter Property="CornerRadius" Value="{StaticResource FwRadius}"/><Setter Property="Padding" Value="{StaticResource FwControlPadding}"/><Setter Property="FontSize" Value="{StaticResource FwFontBody}"/><Setter Property="Background" Value="{DynamicResource FwInput}"/><Setter Property="BorderBrush" Value="{DynamicResource FwBorder}"/><Setter Property="Foreground" Value="{DynamicResource FwTextPrimary}"/></Style>
 <Style Selector="ComboBox"><Setter Property="MinHeight" Value="28"/><Setter Property="CornerRadius" Value="{StaticResource FwRadius}"/><Setter Property="Padding" Value="{StaticResource FwControlPadding}"/><Setter Property="FontSize" Value="{StaticResource FwFontBody}"/><Setter Property="Background" Value="{DynamicResource FwInput}"/></Style>
 <Style Selector="NumericUpDown"><Setter Property="MinHeight" Value="28"/><Setter Property="CornerRadius" Value="{StaticResource FwRadius}"/><Setter Property="FontSize" Value="{StaticResource FwFontBody}"/></Style>
 <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource FwTextMuted}"/></Style>
 <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="{DynamicResource FwTextMuted}"/><Setter Property="FontSize" Value="{StaticResource FwFontCaption}"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
 <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="{StaticResource FwFontSection}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style Selector="TabItem"><Setter Property="FontSize" Value="{StaticResource FwFontBody}"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="32"/></Style>
 <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource FwAccent}"/></Style>
 <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="{DynamicResource FwAccent}"/></Style>
 <Style Selector="TextBox[AcceptsReturn=True]"><Setter Property="VerticalContentAlignment" Value="Top"/></Style>
 <Style Selector="Button:disabled"><Setter Property="Foreground" Value="{DynamicResource FwPastText}"/><Setter Property="Opacity" Value="0.4"/></Style>
 <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/></Style>
 <Style Selector="ListBoxItem"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,4"/><Setter Property="CornerRadius" Value="{StaticResource FwRadius}"/><Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource FwRadius}"><ContentPresenter Background="Transparent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></Border></ControlTemplate></Setter></Style>
 <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource FwAccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource FwAccent}"/><Setter Property="BorderThickness" Value="2,0,0,0"/></Style>
 <Style Selector="ListBoxItem:selected TextBlock"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource FwTextPrimary}"/></Style>
</Styles>
